// The host↔guest contract for vela extensions, as a WIT interface. The host
// generates bindings with `wasmtime::component::bindgen!`; a guest SDK (PR3)
// generates its side with `wit-bindgen`. The Component Model lifts these typed
// records across the sandbox boundary — no hand-rolled linear-memory marshaling.
//
// Versioned by the package version. Adding an export is breaking (a guest must
// provide it); adding an import — a host capability the guest may ignore — is
// compatible, so it's a minor bump. Components match structurally: a guest
// instantiates as long as it exports what the world requires and imports only
// capabilities the host granted it.
package vela:extension@0.3.0;

interface decision {
    // Where an event originated. A `block` verdict is a hard reject for `local`
    // (we refuse to originate the event) but MUST be treated as a soft-fail for
    // `federation` by the host — rejecting an event peers accepted would hole
    // our DAG. The guest just reports a verdict; the host applies origin policy.
    enum origin {
        local,
        federation,
    }

    // The per-event data handed to a plugin at a decision point. `event` and
    // `plugin-config` carry canonical JSON as strings (PDUs are schemaless);
    // everything else is a typed field.
    record event-context {
        // Canonical JSON of the event/PDU.
        event: string,
        room-id: string,
        sender: string,
        // The `type` field of the event, e.g. "m.room.message".
        event-type: string,
        origin: origin,
        // This plugin's opaque config, verbatim JSON. Empty string if none.
        plugin-config: string,
    }

    record block-reason {
        // Matrix error code, e.g. "M_FORBIDDEN".
        errcode: string,
        reason: string,
    }

    // What a plugin returns from a decision point.
    variant verdict {
        allow,
        block(block-reason),
    }

    // The decision hook (sync, on the critical path). Host capabilities are
    // reachable from here at the world level, but the SDK withholds them to keep
    // the hot path pure — capabilities are surfaced through the observation hook.
    check-event: func(ctx: event-context) -> verdict;
}

// Async observation: the host calls this off the request hot path (a worker
// pool), after an event is persisted. No verdict — an observer cannot block.
// `on-event` is where audit, metrics, and (once capabilities are granted) bots
// live. Sandbox limits still apply.
interface observation {
    use decision.{event-context};

    on-event: func(ctx: event-context);
}

// Host capabilities — IMPORTS the guest may call back into. These are the only
// way out of the sandbox: a plugin can do nothing to the world except through
// the capabilities the host grants it. v1 grants `logging` (write a line to
// vela's log, attributed to the plugin); `kv` and `emit-event` are added as
// sibling interfaces later, each grantable independently.
interface logging {
    enum log-level {
        error,
        warn,
        info,
        debug,
        trace,
    }

    // Write one line to vela's log, tagged with this plugin's name. Pure output:
    // no events, no I/O. Best-effort — the host may truncate the message and
    // rate-limit calls within a single invocation.
    log: func(level: log-level, message: string);
}

// A plugin component exports both interfaces. A plugin that only cares about one
// no-ops the other (the SDK provides no-op defaults); the operator's `points`
// config decides which the host actually invokes. It may also import host
// capabilities (`logging` today) — the host provides those it grants.
world plugin {
    import logging;
    export decision;
    export observation;
}
