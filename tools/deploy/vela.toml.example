# vela homeserver — annotated production config.
#
# Copy this file to /etc/vela/vela.toml, edit `server.name`, and start
# vela. Most fields have sensible defaults; the only one you MUST
# change for a real deployment is `server.name`.
#
# This example assumes a reverse proxy (Caddy in tools/deploy/) handles
# TLS on ports 443 and 8448; vela serves plain HTTP behind it. If you
# want vela to terminate its own TLS, see the [server.tls] section
# at the bottom.

[server]
# Public homeserver name. Appears in user IDs (`@alice:vela.example.com`)
# and in X-Matrix headers peers see. Must match your DNS / .well-known.
#
# CHANGE THIS.
name = "vela.example.com"

# vela listens on this address; Caddy reaches it inside the docker
# network. 127.0.0.1 keeps the listener local-only when not in Docker.
bind = "127.0.0.1"
port = 8008

[database]
# Persistent volume mount-point.
path = "/var/lib/vela"

[federation]
# Federation lets users on this server talk to users on other Matrix
# servers. Set false for a fully-private deployment — vela refuses all
# server-to-server traffic in both directions when off.
enabled = true

[registration]
# Closed-signup is the right default for most self-hosted servers.
# Without `enabled = false` OR a `token`, anyone reaching the server
# can sign up. Almost always wrong outside a public community.
enabled = true

# Distribute this token out-of-band; clients pass it via the
# `m.login.registration_token` UIA stage. Generate with
# `openssl rand -hex 16`.
# token = "REPLACE_WITH_SECRET_TOKEN"

[media]
# Size cap for uploads. Default 50MB; raise for big-file workflows.
max_upload_size = "50MB"

# Default backend: filesystem (under <database.path>/media). Switch to
# s3 for off-host durability or shared storage across restarts.
backend = "fs"
# [media.s3]
# bucket             = "vela-media"
# region             = "us-east-1"
# endpoint           = "https://s3.us-east-005.backblazeb2.com"
# access_key_id      = "..."
# secret_access_key  = "..."
# prefix             = "media"
# allow_http         = false

[room_defaults]
# Server-side encryption-by-default for new rooms. When `/createRoom`
# omits `m.room.encryption` in `initial_state`, vela injects it for
# matching room types.
#
# Values: off | dm_only | private_only | all
# Public rooms are NEVER auto-encrypted regardless of this setting.
encrypt_by_default = "private_only"

[user_directory]
# Privacy-first: only return users sharing a room with the caller.
# Set true on invite-only deployments wanting full-directory openness.
search_all_users = false
# Don't query remote servers — forces full MXID for cross-server DMs.
federate = false

[directory]
# Don't expose published room list to the federated graph.
allow_public_rooms_over_federation = false

[backup]
# In-process backup scheduler. Off by default; enable + set a target.
# enabled  = true
# interval = "24h"
# target   = "disk:/var/lib/vela/backups"
# # Or off-host:
# # target = "s3://your-backup-bucket/vela"
# keep     = 7
# [backup.s3]
# region            = "us-east-1"
# access_key_id     = "..."
# secret_access_key = "..."

[retention]
# Periodic media retention sweeper. Off by default.
# enabled  = true
# interval = "24h"
# [retention.media]
# local_lifetime  = "forever"
# remote_lifetime = "30d"

[presence]
# Auto-decay thresholds for the user-presence state machine. After a
# user goes idle (no /sync activity) for `idle_after`, effective
# presence transitions online -> unavailable. After `offline_after`,
# unavailable -> offline. A background sweeper persists the transition
# and broadcasts the federation EDU every `sweep_interval`.
# Defaults match Synapse roughly; raise idle_after if your clients
# poll /sync infrequently.
# idle_after     = "5min"
# offline_after  = "30min"
# sweep_interval = "60s"

# [support]
# Served at GET /.well-known/matrix/support (MSC1929 / spec v1.10) so
# clients and abuse-handling tooling can find who to contact. Leave the
# whole section out and the endpoint returns 404. Each contact needs at
# least one of matrix_id / email_address; role is "m.role.admin" or
# "m.role.security". support_page is an optional help URL.
# support_page = "https://example.com/matrix-support"
# [[support.contacts]]
# matrix_id     = "@admin:example.com"
# email_address = "admin@example.com"
# role          = "m.role.admin"

# --- vela-managed TLS (alternative to running Caddy in front) -------------
# Uncomment if you'd rather vela terminate TLS directly instead of
# putting a reverse proxy in front. You become responsible for cert
# renewal in that case.
# [server.tls]
# port      = 8448
# cert_file = "/etc/vela/tls/fullchain.pem"
# key_file  = "/etc/vela/tls/privkey.pem"

# --- MSC3861 delegated authentication (OAuth 2.0 / OIDC) ------------------
# When enabled, vela hands the login flow off to an external identity
# provider (Matrix Authentication Service, Keycloak, Auth0, ...) and
# validates every incoming Bearer token via RFC 7662 introspection.
#
# Phase 1 only (discovery) — uncomment the first three lines:
#   `enabled = true` + `issuer = ...` makes /_matrix/client/v1/auth_issuer
#   advertise the IdP. Legacy /login + /register keep working.
#
# Phase 2 (full delegated auth) — add the introspection settings.
#   Once `introspection_endpoint` is set vela refuses m.login.password
#   and non-AS /register (clients are expected to bounce to the IdP).
#   Application-service callers + Bearer-token AS masquerade are NOT
#   affected; bridges keep working under delegated auth.
#
# Required IdP setup:
#   - vela's client_id registered at the IdP with the introspection
#     scope (`token-introspect` or whatever the IdP calls it).
#   - IdP must issue tokens whose scope contains
#     `urn:matrix:client:api:*` (or the unstable
#     `urn:matrix:org.matrix.msc2967.client:api:*` variant).
#   - IdP must include a stable `device_id` claim per session, either
#     top-level or via a `urn:matrix:client:device:<id>` scope token.
#
# [auth.oidc]
# enabled                       = true
# issuer                        = "https://auth.example.com/"
# account_management_url        = "https://auth.example.com/account"
# introspection_endpoint        = "https://auth.example.com/oauth2/introspect"
# introspection_client_id       = "vela"
# introspection_client_secret   = "<from your IdP>"
# introspection_auth_method     = "client_secret_basic"   # or "client_secret_post"
