{
  "title": "Vela",
  "uid": "vela-default",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["matrix", "vela"],
  "timepicker": {},
  "templating": { "list": [] },
  "panels": [
    {
      "type": "stat",
      "title": "Up",
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "DOWN", "color": "red" } }, "type": "value" },
            { "options": { "1": { "text": "UP", "color": "green" } }, "type": "value" }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "red" }, { "value": 1, "color": "green" }] }
        }
      },
      "targets": [{ "expr": "up{job=\"vela\"}", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } }]
    },
    {
      "type": "stat",
      "title": "Requests / sec (1m)",
      "id": 2,
      "gridPos": { "x": 4, "y": 0, "w": 5, "h": 4 },
      "targets": [{ "expr": "sum(rate(vela_http_requests_total[1m]))", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } }]
    },
    {
      "type": "stat",
      "title": "5xx ratio (5m)",
      "id": 3,
      "gridPos": { "x": 9, "y": 0, "w": 5, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 0.005, "color": "yellow" }, { "value": 0.02, "color": "red" }] }
        }
      },
      "targets": [{ "expr": "sum(rate(vela_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(vela_http_requests_total[5m]))", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } }]
    },
    {
      "type": "stat",
      "title": "p99 latency (5m, all routes)",
      "id": 4,
      "gridPos": { "x": 14, "y": 0, "w": 5, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3 } },
      "targets": [{ "expr": "histogram_quantile(0.99, sum by (le) (rate(vela_http_request_duration_seconds_bucket[5m])))", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } }]
    },
    {
      "type": "timeseries",
      "title": "Request rate by route",
      "id": 10,
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "expr": "sum by (route) (rate(vela_http_requests_total[1m]))", "legendFormat": "{{route}}", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } }]
    },
    {
      "type": "timeseries",
      "title": "p50 / p95 / p99 latency",
      "id": 11,
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(vela_http_request_duration_seconds_bucket[1m])))", "legendFormat": "p50", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(vela_http_request_duration_seconds_bucket[1m])))", "legendFormat": "p95", "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(vela_http_request_duration_seconds_bucket[1m])))", "legendFormat": "p99", "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error rate by status",
      "id": 12,
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "expr": "sum by (status) (rate(vela_http_requests_total{status!~\"2..\"}[1m]))", "legendFormat": "{{status}}", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } }]
    },
    {
      "type": "timeseries",
      "title": "Top 10 slowest routes (p95)",
      "id": 13,
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "expr": "topk(10, histogram_quantile(0.95, sum by (route, le) (rate(vela_http_request_duration_seconds_bucket[5m]))))", "legendFormat": "{{route}}", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } }]
    }
  ]
}
