+	// Wait for our handler to observe the leave before returning (and thus
+	// removing the handler). The channel is buffered, so a leave delivered
+	// during leaveAction is still queued here — we must drain it rather than
+	// rely on room.CurrentState, because the transaction goroutine updates
+	// room state (via AddEvent) *before* it invokes our handler. Removing the
+	// handler off the back of a CurrentState observation therefore races the
+	// in-flight handler call, which then sees an empty handler set and reports
+	// the leave as an unexpected PDU. Draining the channel first guarantees the
+	// handler call has completed before removal.
+	select {
+	case <-leaveChannel:
+		t.Logf("%s saw %s leave test room %s.", s.ServerName(), userID, room.RoomID)
+	case <-time.After(1 * time.Second):
+		// Nothing arrived in a second: either the leave was applied before our
+		// handler was registered (so the channel will never receive it) or it
+		// genuinely never came. Distinguish via room state.
+		memberEvent := room.CurrentState("m.room.member", userID)
+		membership := ""
+		if memberEvent != nil {
+			membership, _ = memberEvent.Membership()
+		}
+		if membership == "leave" {
+			t.Logf("%s has already seen %s leave test room %s.", s.ServerName(), userID, room.RoomID)
+		} else {
 			t.Errorf("%s timed out waiting for %s to leave test room %s.", s.ServerName(), userID, room.RoomID)
 		}
