// The host↔guest contract for vela extensions, as a WIT interface. The host
// generates bindings with `wasmtime::component::bindgen!`; a guest SDK (PR3)
// generates its side with `wit-bindgen`. The Component Model lifts these typed
// records across the sandbox boundary — no hand-rolled linear-memory marshaling.
//
// Versioned by the package version. The version is baked into every interface's
// identity (e.g. a guest imports `vela:extension/logging@0.4.0`), so ANY bump —
// even a purely additive one like a new capability interface — requires
// rebuilding every component against the new version; an older component won't
// match the host's linker. So a bump is effectively breaking for already-built
// components regardless of what changed; the committed fixtures/examples are
// rebuilt with each bump. (Within a fixed version, a guest still instantiates as
// long as it exports what the world requires and imports only granted caps.)
package vela:extension@0.11.0;

interface decision {
    // Where an event originated. A `block` verdict is a hard reject for `local`
    // (we refuse to originate the event) but MUST be treated as a soft-fail for
    // `federation` by the host — rejecting an event peers accepted would hole
    // our DAG. The guest just reports a verdict; the host applies origin policy.
    enum origin {
        local,
        federation,
    }

    // The per-event data handed to a plugin at a decision point. `event` and
    // `plugin-config` carry canonical JSON as strings (PDUs are schemaless);
    // everything else is a typed field.
    record event-context {
        // Canonical JSON of the event/PDU.
        event: string,
        room-id: string,
        sender: string,
        // The `type` field of the event, e.g. "m.room.message".
        event-type: string,
        origin: origin,
        // This plugin's opaque config, verbatim JSON. Empty string if none.
        plugin-config: string,
    }

    record block-reason {
        // Matrix error code, e.g. "M_FORBIDDEN".
        errcode: string,
        reason: string,
    }

    // What a plugin returns from a decision point.
    variant verdict {
        allow,
        block(block-reason),
    }

    // The decision hook (sync, on the critical path). Host capabilities are
    // reachable from here at the world level, but the SDK withholds them to keep
    // the hot path pure — capabilities are surfaced through the observation hook.
    check-event: func(ctx: event-context) -> verdict;

    // Signup metadata handed to a plugin at /register, before the account is
    // created — a second decision point (different context + call site, same
    // allow/block verdict). A block rejects the registration with the verdict's
    // errcode/reason. The `kv` capability works here too (stateful rate limits).
    record registration-context {
        // Requested localpart, e.g. "alice".
        username: string,
        // How they're registering. Today the /register handler emits "open" or
        // "token"; "oidc" / "guest" / "appservice" are reserved for future call
        // sites (those signup paths don't invoke this point yet).
        kind: string,
        // An opaque IP token per the plugin's operator-set `client_ip` tier:
        // absent (none), a non-reversible HMAC (hashed — a rate-limit key that
        // reveals nothing about the address), or the raw IP (full). Treat it as
        // an opaque key unless the plugin was granted `full`.
        client-ip: option<string>,
        // This plugin's opaque config, verbatim JSON. Empty string if none.
        plugin-config: string,
    }
    check-registration: func(ctx: registration-context) -> verdict;

    // Login metadata handed to a plugin at /login, before the password is verified
    // — anti-brute-force / credential-stuffing, IP/geo blocking, login policy. The
    // sibling of check-registration: same decision shape, same privacy-tiered IP. A
    // block rejects the login (403, plugin errcode) without leaking whether the
    // credentials were valid (it keys on username/IP, not the auth result). The
    // `kv` capability works here (a per-IP/username attempt counter).
    record login-context {
        // The requested username/localpart. May not exist — don't leak existence.
        username: string,
        // The login type, e.g. "m.login.password".
        login-type: string,
        // Privacy-tiered IP token per the plugin's `client_ip` tier: absent
        // (none), a non-reversible HMAC (hashed — a rate-limit key), or the raw IP
        // (full). Same tiering as check-registration; treat as opaque unless `full`.
        client-ip: option<string>,
        // This plugin's opaque config, verbatim JSON. Empty string if none.
        plugin-config: string,
    }
    check-login: func(ctx: login-context) -> verdict;

    // Media-upload metadata, after the bytes are stored but before the upload is
    // downloadable. v1 is hash + metadata only (the upload streams, so the bytes
    // aren't buffered): enough for exact known-bad-hash blocklists and
    // MIME/size/filename policy. A block deletes the stored bytes and rejects the
    // upload — blocked media is never servable. (Raw content for novel scanning
    // is a later phase that needs a streaming/read-back interface.) E2EE media is
    // already ciphertext at upload, so it's unscannable by nature — the server
    // never decrypts.
    record media-context {
        // Client-declared MIME type.
        content-type: string,
        // Original filename if the client sent one; else empty.
        filename: string,
        // Size in bytes.
        size: u64,
        // The uploading user's id.
        uploader: string,
        // Lowercase hex SHA-256 of the content, computed in-stream.
        sha256: string,
        // This plugin's opaque config, verbatim JSON. Empty string if none.
        plugin-config: string,
    }
    check-media-upload: func(ctx: media-context) -> verdict;

    // A user setting their own display name or avatar, at the `/profile`
    // endpoints — before the change is persisted or propagated. Anti-impersonation
    // and name/avatar policy (a block rejects the update with the verdict's
    // errcode/reason). Local only: a remote user's profile change arrives as an
    // `m.room.member` PDU and is a `check-event` concern, so this point never sees
    // federation traffic. The `kv` capability works here (per-user churn limits).
    enum profile-field {
        display-name,
        avatar-url,
    }
    record profile-context {
        // The user changing their own profile.
        user-id: string,
        // Which field is being set.
        field: profile-field,
        // The proposed new value; `none` means the user is clearing the field
        // (the host normalizes an empty string to `none`, so clearing always looks
        // the same regardless of which endpoint cleared it). For `avatar-url` this
        // is the mxc:// URI, not the image — image scanning is
        // `check-media-upload`'s job at upload time, so a profile plugin can
        // enforce URI/domain policy but cannot inspect pixels.
        value: option<string>,
        // This plugin's opaque config, verbatim JSON. Empty string if none.
        plugin-config: string,
    }
    check-profile-update: func(ctx: profile-context) -> verdict;

    // A user creating a room, at `POST /createRoom`, before anything is persisted.
    // Room-creation policy: anti-spam, invite-bomb caps, no-public-rooms, alias
    // policy. A block rejects the creation with the verdict's errcode/reason. Local
    // only: rooms federate via joins, not creation. The `kv` capability works here
    // (per-creator rate limits). `visibility` is the requested directory listing
    // intent (so a no-public-rooms rule keys on it) — the create-vs-publish split
    // folds into one point.
    record room-create-context {
        // The creating user, @user:server.
        creator: string,
        // The room id the server derived for this creation.
        room-id: string,
        room-version: string,
        // Resolved preset, normally "public_chat" | "private_chat" |
        // "trusted_private_chat". Client-supplied and not validated against that
        // set, so an unknown value can pass through (the server treats unknown as
        // private); key a "no public rooms" rule on `visibility`, not `preset`.
        preset: string,
        // Requested directory visibility, "public" | "private"; `none` if unset.
        visibility: option<string>,
        name: option<string>,
        topic: option<string>,
        // Requested alias localpart, e.g. "foo" for #foo:server; `none` if unset.
        alias-localpart: option<string>,
        // Users invited at creation time (an invite-bomb signal / target list).
        invite: list<string>,
        is-direct: bool,
        // This plugin's opaque config, verbatim JSON. Empty string if none.
        plugin-config: string,
    }
    check-room-create: func(ctx: room-create-context) -> verdict;

    // A read-path filter: as `/sync` builds a user's timeline, decide per event
    // whether THIS viewer sees it (operator-controlled per-viewer visibility —
    // quarantine, compliance, content policy). The first hook that's about who is
    // *reading*, not about the event/action itself. It's a filter, not a
    // verdict-with-reason: a hidden event is silently dropped, so the return is a
    // plain bool (`true` = show, `false` = hide). Timeline events only (filtering
    // state would corrupt the client's room state); the `kv` capability works here
    // (a stateful per-viewer policy). Fail-policy: open → show, closed → hide.
    record sync-event-context {
        // The user doing the /sync — the viewer whose visibility is being decided.
        viewer: string,
        room-id: string,
        // Canonical JSON of the event.
        event: string,
        // The `type` field, e.g. "m.room.message".
        event-type: string,
        sender: string,
        // This plugin's opaque config, verbatim JSON. Empty string if none.
        plugin-config: string,
    }
    filter-sync-event: func(ctx: sync-event-context) -> bool;
}

// Async observation: the host calls this off the request hot path (a worker
// pool), after an event is persisted. No verdict — an observer cannot block.
// `on-event` is where audit, metrics, and (once capabilities are granted) bots
// live. Sandbox limits still apply.
interface observation {
    use decision.{event-context};

    on-event: func(ctx: event-context);
}

// Host capabilities — IMPORTS the guest may call back into. These are the only
// way out of the sandbox: a plugin can do nothing to the world except through
// the capabilities the host grants it. v1 grants `logging` (write a line to
// vela's log, attributed to the plugin); `kv` and `emit-event` are added as
// sibling interfaces later, each grantable independently.
interface logging {
    enum log-level {
        error,
        warn,
        info,
        debug,
        trace,
    }

    // Write one line to vela's log, tagged with this plugin's name. Pure output:
    // no events, no I/O. Best-effort — the host may truncate the message and
    // rate-limit calls within a single invocation.
    log: func(level: log-level, message: string);
}

// The `emit-event` capability — post an event into a room as the plugin's own
// bot user (`@_ext_<name>`). Granted per-plugin by the operator (the host links
// this interface only when granted) and usable only from `on_event`. The event
// goes through normal room authorization: the bot must be joined with power
// level, or `emit` is `unauthorized` — there is no auth bypass.
interface emit {
    // The event to post. `content` is canonical JSON of the event content; a
    // present `state-key` makes it a state event (rejected in v1 — message,
    // reaction, and redaction only).
    record new-event {
        room-id: string,
        event-type: string,
        content: string,
        state-key: option<string>,
    }
    variant emit-error {
        // the bot isn't joined / lacks power level in that room
        unauthorized,
        // not granted, called off on_event, disallowed type, or malformed content
        not-permitted(string),
        // this plugin's emit rate cap tripped
        rate-limited,
        // internal failure (persist/lock) — logged host-side
        internal,
    }
    // Returns the new event's id on success.
    emit-event: func(event: new-event) -> result<string, emit-error>;
}

// A plugin component exports both interfaces. A plugin that only cares about one
// no-ops the other (the SDK provides no-op defaults); the operator's `points`
// config decides which the host actually invokes. It may also import host
// capabilities (`logging` today) — the host provides those it grants.
// The `kv` capability — a small per-plugin key→value store (the Redis model:
// flat keys, optional TTL, byte quota). Granted per-plugin; usable from BOTH
// points (it's synchronous, so a stateful `check_event` can rate-limit/dedup).
// Keys are namespaced by the host per plugin — a plugin can't read another's.
// Opaque bytes both ways; the plugin serializes its own values.
interface kv {
    variant kv-error {
        // not granted, or the key/value exceeds the per-op size cap
        not-permitted(string),
        // this plugin is over its byte budget — free space (delete / shorter TTL)
        quota-exceeded,
        // internal store failure (logged host-side)
        internal,
    }
    // Read a key. Absent or expired → `none`.
    get: func(key: list<u8>) -> result<option<list<u8>>, kv-error>;
    // Write a key, optionally with a relative time-to-live in milliseconds.
    // `none` (or `some(0)`) = no expiry. The host turns ttl into an absolute
    // wall-clock deadline — TTLs are not monotonic, so a server clock step can
    // make an entry expire a little early or late (fine for counters/dedup).
    set: func(key: list<u8>, value: list<u8>, ttl-ms: option<u64>) -> result<_, kv-error>;
    // Delete a key. Idempotent.
    delete: func(key: list<u8>) -> result<_, kv-error>;
}

world plugin {
    import logging;
    import emit;
    import kv;
    export decision;
    export observation;
}
